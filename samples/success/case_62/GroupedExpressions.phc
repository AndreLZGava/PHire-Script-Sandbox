<?php

declare(strict_types=1);


namespace PHireScript\Sandbox\samples\success\case_62;


 class GroupedExpressions
{

    public function __construct(
        float $a,
        float $b,
        float $c,
        float $d,
    ) {
        $this->a = $a;
        $this->b = $b;
        $this->c = $c;
        $this->d = $d;
        
    }
    public float $a;
    public float $b;
    public float $c;
    public float $d;
    private function getGrouped(): float{
$result = ($this->a + $this->b) * $this->c;
return $result;
}

}

