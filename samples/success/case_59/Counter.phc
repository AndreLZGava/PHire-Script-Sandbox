<?php

declare(strict_types=1);


namespace PHireScript\Sandbox\samples\success\case_59;


 class Counter
{

    public function __construct(
        int $count,
    ) {
        $this->count = $count;
        
    }
    public int $count;
    public function getCount(): int
    {
        return $this->count;
    }

    public function setCount(int $count): void
    {
        $this->count = $count;
    }

}

