<?php

declare(strict_types=1);


namespace PHireScript\Sandbox\samples\success\case_3;


 class MagicMethods
{
    public function __construct(String $test = 't', Bool $isSelf = true){
return ;
}

    public function __destruct(){
return ;
}

    public function __get(String $myTest): mixed{
return true;
}

    public function __set(String $property, Mixed $value): void{
return ;
}

    public function hasHas(String $property): bool{
return true;
}

    public function __unset(String $property): void{
return ;
}

    public function __call(String $method, Array $arguments): mixed{
return true;
}

    static public function __callStatic(String $method, Array $arguments): mixed{
return true;
}

    public function __toString(): string{
return 'example';
}

    public function __serialize(): array{
return [
'not empty'
];
}

    public function __sleep(): array{
return [
'another array'
];
}

    public function __wakeup(): void{
return ;
}

    public function __clone(): void{
return ;
}

    public function __debugInfo(): array{
return [
'Example'
];
}

}

