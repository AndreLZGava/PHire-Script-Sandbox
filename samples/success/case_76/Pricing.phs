pkg PHireScript.Samples76

class Pricing as scoped {
    Float price
    Float taxRate

    # getPrice(): Float {
        return this.price
    }

    # getTaxRate(): Float {
        return this.taxRate
    }

    # priceWithTax(): Float {
        result = this.getPrice() * (1 + this.getTaxRate())
        return result
    }

