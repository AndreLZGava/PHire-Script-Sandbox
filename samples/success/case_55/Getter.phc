<?php

declare(strict_types=1);


namespace PHireScript\Sandbox\samples\success\case_55;


 class Getter
{

    public function __construct(
        int $id,
        string $name,
        bool $active,
    ) {
        $this->id = $id;
        $this->name = $name;
        $this->active = $active;
        
    }
    public int $id;
    public string $name;
    public bool $active;
    public function getId(): int
    {
        return $this->id;
    }

    public function getName(): string
    {
        return $this->name;
    }

    public function getActive(): bool
    {
        return $this->active;
    }

}

